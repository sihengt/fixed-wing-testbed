{
  "name": "fixed-wing-testbed",
  "build": {
    "dockerfile": "Dockerfile",
    "args": { "HOST_HOME": "${localEnv:HOME}" }
  },
  "remoteUser": "ubuntu",
  // Host paths are kept, so Claude Code finds this project's conversations and memory.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=${localEnv:HOME}/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/tmp/host-claude.json,type=bind,readonly",
    // Direct host X socket: the VS Code X11 forward is too slow for OpenGL (Gazebo).
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  // Needs the NVIDIA Container Toolkit on the host.
  "runArgs": ["--gpus=all"],
  "containerEnv": {
    "NVIDIA_DRIVER_CAPABILITIES": "all",
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  // A copy, not a mount: Claude Code replaces this file on save, which fails on a single-file mount.
  "postCreateCommand": "cp --update=none /tmp/host-claude.json ~/.claude.json",
  "customizations": {
    "vscode": { "extensions": ["anthropic.claude-code"] }
  }
}
