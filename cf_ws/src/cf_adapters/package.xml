<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cf_adapters</name>
  <version>0.1.0</version>
  <description>Glue between the fixed-wing testbed and cf_drone modules, to test which ones carry over.</description>
  <maintainer email="siheng.teng@gmail.com">sihengt</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>octomap</depend>
  <depend>octomap_msgs</depend>
  <exec_depend>jps3d</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>waypoint_flyer</exec_depend>
  <exec_depend>fw_planner</exec_depend>
  <exec_depend>stereo_disparity</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>attitude_pid</exec_depend>
  <exec_depend>airstack_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
