<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fw_planner</name>
  <version>0.1.0</version>
  <description>Hybrid A* / Dubins global planner for fixed-wing aircraft.</description>
  <maintainer email="siheng.teng@gmail.com">sihengt</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>waypoint_flyer</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- plot_flight also needs pyulog, installed by PX4's setup script (pip). -->
  <!-- rrt_star needs OMPL 2.x Python (pip wheel `ompl`, see .devcontainer/install-px4-deps.sh). -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
