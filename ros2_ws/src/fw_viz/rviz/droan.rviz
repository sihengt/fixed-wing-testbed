Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (50 m)
      Enabled: true
      Cell Size: 50
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.4
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: World (no-fly zones, bounds, goals)
      Enabled: true
      Topic:
        Value: /planner_markers
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Color: 31; 119; 180
      Alpha: 1
      Line Style: Billboards
      Line Width: 2
      Buffer Length: 1
      Pose Style: None
      Topic:
        Value: /planned_path
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Flown track
      Enabled: true
      Color: 255; 127; 14
      Alpha: 1
      Line Style: Billboards
      Line Width: 1.5
      Buffer Length: 1
      Pose Style: None
      Topic:
        Value: /flown_path
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Plane
      Enabled: true
      Topic:
        Value: /plane_marker
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: DROAN trajectories (green free, red colliding)
      Enabled: true
      Topic:
        Value: /traj_debug
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Color: 160; 160; 160
      Alpha: 1
      Line Style: Lines
      Line Width: 1
      Buffer Length: 1
      Pose Style: None
      Topic:
        Value: /global_plan
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Left camera
      Enabled: true
      Topic:
        Value: /stereo/left/image
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 44; 52
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: Follow the plane
      Target Frame: plane_body
      Distance: 300
      Pitch: 0.75
      Yaw: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Near Clip Distance: 0.5
      Value: ThirdPersonFollower (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
